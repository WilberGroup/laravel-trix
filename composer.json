{
    "name": "wilber/laravel-trix",
    "description": "trix editor for laravel inspired by ActionText for rails",
    "keywords": [
        "wilber",
        "laravel-trix"
    ],
    "homepage": "https://github.com/WilberGroup/laravel-trix",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Wilber Group",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^7.1|^8.0",
        "laravel/framework": "~5.8.0|~6.0|~7.0|~8.0|~9.0|^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^3.5|~4.0|~5.0|~6.0|^8.0|^9.0|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Wilber\\LaravelTrix\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wilber\\LaravelTrix\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Wilber\\LaravelTrix\\LaravelTrixServiceProvider"
            ]
        }
    }
}
